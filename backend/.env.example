APP_NAME=SDLC Agent
# development | production。非 development 环境强制要求自定义 SECRET_KEY，
# 并自动关闭本地用户兜底与不安全命令。
ENV=development
DATABASE_URL=sqlite:///./data/sdlc.db
# 生产环境必须替换为随机值：python -c "import secrets;print(secrets.token_urlsafe(48))"
# 该密钥同时用于 JWT 签名与 Provider API Key 加密，更换后已有 token 与密钥会失效。
SECRET_KEY=dev-secret-key-change-me-please-0123456789
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 本地单机模式：无 token 时自动降级为内置 local 用户（仅开发环境生效）。
ALLOW_LOCAL_USER_FALLBACK=true
# 编码 Agent 是否允许执行 python -c / -m 任意模块（默认关闭）。
ALLOW_UNSAFE_COMMANDS=false
# LLM Provider base_url 主机名白名单，留空表示只拦截链路本地等危险地址。
ALLOWED_PROVIDER_HOSTS=[]
# 目录浏览接口的根目录限制，留空表示不限制。
FS_BROWSE_ROOT=
