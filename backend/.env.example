# SDLC Agent 后端环境变量示例。
# 复制为 backend/.env 后按需修改；未设置的项使用 app/core/config.py 中的默认值。

# 应用名称（展示用）
APP_NAME=SDLC Agent

# 运行环境：development / dev / local / test 视为开发环境。
# 非开发环境必须显式设置 SECRET_KEY，否则拒绝启动。
ENV=development

# 数据库与工作区
DATABASE_URL=sqlite:///./data/sdlc.db
PROJECT_WORKSPACE_ROOT=./data/projects

# JWT 签名与 Provider API Key 加密密钥。
# 非开发环境必填；生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
# SECRET_KEY=change-me

# 访问令牌有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 允许跨域的前端来源（JSON 数组）
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 开发环境未携带 token 时自动降级为内置 local 用户（非开发环境强制关闭）
ALLOW_LOCAL_USER_FALLBACK=true

# 是否允许编码 Agent 执行任意 Python 代码（python -c / -m），默认关闭
ALLOW_UNSAFE_COMMANDS=false

# Provider base_url 主机名白名单（JSON 数组，留空表示不额外限制；内网/回环地址始终拦截）
ALLOWED_PROVIDER_HOSTS=[]

# 目录浏览接口的根目录限制，留空表示登录后不限制
FS_BROWSE_ROOT=
